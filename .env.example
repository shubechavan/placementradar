# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas connection string (free M0 cluster) — REQUIRED
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/jobs

# API access key — when set, all /api routes (except /api/dashboard) require
# the X-API-Key header. Leave unset for local dev (auth disabled).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# Serper.dev Google Search API key (optional — can also be set in Settings UI)
SERPER_API_KEY=

# Gmail App Password for outreach emails (optional — overrides the value
# stored in the Settings UI; keeps the password out of the database)
GMAIL_APP_PASSWORD=

# GitHub PAT with workflow scope — enables scraping on GitHub Actions
GH_PAT=
