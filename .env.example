# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# MongoDB Atlas connection string (free M0 cluster) — REQUIRED
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/jobs

# Optional: separate database for user login accounts (CRM members).
# If unset, users are stored in the same database as MONGO_URI above.
# Typically the same cluster with a different db name, e.g. .../signup
AUTH_MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/signup

# API access key — machine/CI access (e.g. keepalive pings) via X-API-Key header.
# Browser users log in with accounts instead (see SECRET_KEY / ADMIN_* below).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=

# ── CRM login (Phase 1) ───────────────────────────────────────────────────────
# Secret that signs the login session cookie. REQUIRED in production, or logins
# reset on every restart. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1/true ONLY in production (HTTPS). Makes the session cookie Secure.
# Leave blank for local http dev or the browser will drop the cookie and login fails.
SESSION_COOKIE_SECURE=

# First-admin seed — used once, only when no users exist yet, to create the
# committee head's account. Remove after the first successful login.
ADMIN_NAME=Placement Head
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Serper.dev Google Search API key (optional — can also be set in Settings UI)
SERPER_API_KEY=

# Gmail App Password for outreach emails (optional — overrides the value
# stored in the Settings UI; keeps the password out of the database)
GMAIL_APP_PASSWORD=

# GitHub PAT with workflow scope — enables scraping on GitHub Actions
GH_PAT=
